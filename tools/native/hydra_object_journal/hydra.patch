+void PythonPipeline::enableObjectEventJournal() {
+  if (!step_mode_only_ || stepped_) {
+    throw std::logic_error("Enable the object journal before the first synchronous step");
+  }
+  if (!object_events_) {
+    object_events_ = std::make_shared<ObjectEventJournal>();
+    journal_epoch_ = nextObjectJournalEpoch();
+    frontend_->setObjectEventJournal(object_events_);
+    backend_->setObjectEventJournal(object_events_);
+  }
+}
+
+py::object PythonPipeline::getObjectEventBatch() const {
+  if (!event_batch_) {
+    return py::none();
+  }
+  py::list events;
+  for (const auto& event : *event_batch_) {
+    py::dict entry;
+    entry["owner"] = event.owner == ObjectEventOwner::Frontend ? "frontend" : "backend";
+    switch (event.operation) {
+      case ObjectEventOperation::Create: entry["operation"] = "create"; break;
+      case ObjectEventOperation::Delete: entry["operation"] = "delete"; break;
+      case ObjectEventOperation::Merge: entry["operation"] = "merge"; break;
+    }
+    entry["source"] = NodeSymbol(event.source).str();
+    if (event.target) {
+      entry["target"] = NodeSymbol(*event.target).str();
+    } else {
+      entry["target"] = py::none();
+    }
+    events.append(entry);
+  }
+  py::dict batch;
+  batch["schema_version"] = 1;
+  batch["status"] = "complete";
+  batch["epoch"] = journal_epoch_;
+  batch["step"] = journal_step_;
+  batch["timestamp_ns"] = journal_timestamp_;
+  batch["events"] = events;
+  return batch;
+}
+
 bool PythonPipeline::step(const InputPacket::Ptr& input) {
+  stepped_ = true;
+  if (!object_events_ || journal_gap_) {
+    return stepModules(input);
+  }
+
+  event_batch_.reset();
+  object_events_->begin();
+  try {
+    const bool accepted = stepModules(input);
+    event_batch_ = object_events_->finish(accepted, input->timestamp_ns);
+    journal_gap_ = !event_batch_;
+    if (event_batch_) {
+      ++journal_step_;
+      journal_timestamp_ = input->timestamp_ns;
+    }
+    return accepted;
+  } catch (...) {
+    object_events_->finish(false);
+    journal_gap_ = true;
+    throw;
+  }
+}
+
+bool PythonPipeline::stepModules(const InputPacket::Ptr& input) {
   if (!active_window_->step(input)) {
     return false;
   }
