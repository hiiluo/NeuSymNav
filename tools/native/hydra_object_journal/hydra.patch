+++ b/include/hydra/common/object_event_journal.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <utility>
+#include <vector>
+
+#include <spark_dsg/node_symbol.h>
+
+namespace hydra {
+
+enum class ObjectEventOwner { Frontend, Backend };
+enum class ObjectEventOperation { Create, Delete, Merge };
+
+struct ObjectEvent {
+  ObjectEventOwner owner;
+  ObjectEventOperation operation;
+  spark_dsg::NodeId source;
+  std::optional<spark_dsg::NodeId> target;
+};
+
+// One bounded capture shared by both object owners in a synchronous pipeline step.
+class ObjectEventJournal {
+ public:
+  explicit ObjectEventJournal(std::size_t capacity = 4096) : capacity_(capacity) {}
+
+  void begin() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    events_.clear();
+    overflow_ = false;
+    frontend_input_.reset();
+    backend_input_.reset();
+    active_ = true;
+  }
+
+  void record(ObjectEvent event) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!active_ || overflow_) {
+      return;
+    }
+    if (events_.size() >= capacity_) {
+      overflow_ = true;
+      events_.clear();
+      return;
+    }
+    events_.push_back(std::move(event));
+  }
+
+  void confirm(ObjectEventOwner owner, uint64_t timestamp, uint64_t sequence) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (active_) {
+      auto& input = owner == ObjectEventOwner::Frontend ? frontend_input_ : backend_input_;
+      if (input) {
+        overflow_ = true;  // Multiple packets for one capture are ambiguous.
+      }
+      input = std::make_pair(timestamp, sequence);
+    }
+  }
+
+  std::optional<std::vector<ObjectEvent>> finish(
+      bool accepted, std::optional<uint64_t> expected_timestamp = std::nullopt) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const bool complete = active_ && accepted && !overflow_ &&
+                          (!expected_timestamp || (frontend_input_ &&
+                              frontend_input_->first == *expected_timestamp &&
+                              frontend_input_ == backend_input_));
+    active_ = false;
+    if (!complete) {
+      events_.clear();
+      return std::nullopt;
+    }
+    auto result = std::move(events_);
+    events_.clear();
+    return result;
+  }
+
+ private:
+  const std::size_t capacity_;
+  std::mutex mutex_;
+  bool active_ = false;
+  bool overflow_ = false;
+  std::vector<ObjectEvent> events_;
+  using InputIdentity = std::pair<uint64_t, uint64_t>;
+  std::optional<InputIdentity> frontend_input_;
+  std::optional<InputIdentity> backend_input_;
+};
+
+}  // namespace hydra
