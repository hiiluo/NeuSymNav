+std::mutex rgbd_merge_mutex;
+std::optional<RgbdMergeRequest> rgbd_merge_request;
+
+std::optional<RgbdMergeRequest> takeRgbdMerge(uint64_t timestamp_ns) {
+  const std::lock_guard<std::mutex> lock(rgbd_merge_mutex);
+  if (!rgbd_merge_request || rgbd_merge_request->timestamp_ns != timestamp_ns) {
+    return std::nullopt;
+  }
