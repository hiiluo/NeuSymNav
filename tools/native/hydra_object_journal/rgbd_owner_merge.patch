+  const char* option = std::getenv("NEUSYMNAV_EXPERIMENT_RGBD_OWNER_MERGE");
+  const std::lock_guard<std::mutex> lock(rgbd_merge_mutex);
+  if (!option || std::strcmp(option, "1") != 0 || !timestamp_ns ||
+      rgbd_merge_request || newer_index <= older_index || newer_index >= 8192) {
+    return false;
+  }
+  rgbd_merge_request = RgbdMergeRequest{timestamp_ns, NodeSymbol('O', newer_index),
+                                        NodeSymbol('O', older_index)};
+  return true;
+}
+
