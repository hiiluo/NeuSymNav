+extern "C" bool neusymnav_stage_retired_alias(uint64_t timestamp_ns,
+                                              uint64_t older_index,
+                                              uint64_t newer_index) {
+  const std::lock_guard<std::mutex> lock(rgbd_merge_mutex);
+  if (!retirementEnabled() || !timestamp_ns || rgbd_merge_request ||
+      older_index >= newer_index || newer_index >= max_tombstones) {
+    return false;
+  }
+  rgbd_merge_request = RgbdMergeRequest{timestamp_ns, NodeSymbol('O', older_index),
+                                        NodeSymbol('O', newer_index), true};
+  return true;
+}
+
+// Called by the isolated replay between synchronous pipelines after the old
+// pipeline has finished. No geometry or object IDs survive the reset.
+extern "C" void neusymnav_reset_retired_aliases() {
+  const std::lock_guard<std::mutex> lock(rgbd_merge_mutex);
+  retired_objects.clear();
+  retirement_step = 0;
+  rgbd_merge_request.reset();
+}
