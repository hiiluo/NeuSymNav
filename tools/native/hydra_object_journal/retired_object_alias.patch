+constexpr size_t max_tombstones = 8192;
+constexpr uint64_t reconcile_age = 24;
+std::map<NodeId, std::pair<uint32_t, uint64_t>> retired_objects;
+uint64_t retirement_step = 0;
+
+bool retirementEnabled() {
+  const char* option = std::getenv("NEUSYMNAV_EXPERIMENT_RETIRED_OBJECT_ALIAS");
+  return option && std::strcmp(option, "1") == 0;
+}
+
+void advanceRetirementWindow() {
+  ++retirement_step;
+  for (auto iter = retired_objects.begin(); iter != retired_objects.end();) {
+    if (retirement_step - iter->second.second > reconcile_age) {
+      iter = retired_objects.erase(iter);
+    } else {
+      ++iter;
+    }
+  }
+}
 
