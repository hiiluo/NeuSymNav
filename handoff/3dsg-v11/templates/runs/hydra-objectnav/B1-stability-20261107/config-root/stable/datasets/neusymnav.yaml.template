map_window:
  type: spatial
  max_radius_m: 8.0
active_window:
  volumetric_map:
    voxels_per_side: 16
    voxel_size: 0.1
    truncation_distance: 0.3
  full_update_separation_s: 1.0
  tsdf:
    num_threads: 2
    semantic_integrator:
      type: MLESemanticIntegrator
  mesh:
    integrator_threads: 2
frontend:
  pgmo:
    time_horizon: 15.0
    d_graph_resolution: 2.5
    mesh_resolution: 0.005
  objects:
    min_cluster_size: 40
    cluster_tolerance: 0.25
  freespace_places:
    type: gvd
    gvd:
      max_distance_m: 4.5
      min_distance_m: 0.2
      min_diff_m: 0.1
      voronoi_config:
        mode: L1_THEN_ANGLE
        min_distance_m: 0.3
        parent_l1_separation: 20
        parent_cos_angle_separation: 0.2
    graph:
      type: CompressionGraphExtractor
      compression_distance_m: 0.5
      min_node_distance_m: 0.4
      min_edge_distance_m: 0.2
      node_merge_distance_m: 0.25
      add_heuristic_edges: true
      add_overlap_edges: false
      add_freespace_edges: true
      freespace_edges:
        num_nodes_to_check: 10
        num_neighbors_to_find: 2
        min_clearance_m: 0.2
    tsdf_interpolator:
      type: downsample
      ratio: 2
backend:
  add_places_to_deformation_graph: true
  optimize_on_lc: true
  enable_node_merging: true
  update_functors:
    agents:
      type: UpdateAgentsFunctor
    objects:
      type: UpdateObjectsFunctor
    places:
      type: UpdatePlacesFunctor
      pos_threshold_m: 0.3
      distance_tolerance_m: 0.2
    rooms:
      type: UpdateRoomsFunctor
      room_finder:
        min_dilation_m: 0.5
        max_dilation_m: 1.2
        min_component_size: 3
        min_room_size: 10
        dilation_threshold_mode: PLATEAU
        min_lifetime_length_m: 0.1
        plateau_ratio: 0.25
        clustering_mode: NEIGHBORS
        dilation_diff_threshold_m: -1.0
    buildings:
      type: UpdateBuildingsFunctor
  pgmo:
    run_mode: FULL
    embed_trajectory_delta_t: 5.0
    num_interp_pts: 3
    interp_horizon: 10.0
    optimizer:
      type: KimeraRpgoOptimizer
      solver: LM
      gnc:
        inlier_probability: 0.9
        mu_step: 1.6
        max_iterations: 100
    add_initial_prior: true
    covariance:
      odom: 0.01
      loop_close: 0.05
      sg_loop_close: 0.1
      prior: 0.01
      mesh_mesh: 0.01
      pose_mesh: 0.01
      place_mesh: 0.01
      place_edge: 0.01
      place_merge: 10.0
      object_merge: 10.0
neusymnav_room_stability:
  enabled: true
  library_path: @REPO@/runs/hydra-objectnav/B1-stability-20261107/native/libhydra.so
  library_sha256: 9364ca487e8826112705d942ff01734cdbe3372fbdcc91c21c42a14a42fb7e4b
