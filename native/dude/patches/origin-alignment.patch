 namespace {
 
 constexpr double kMinStableContourAreaPixels = 1.0;
+
+// NeuSymNav local modification (2026-10-31): preserve integer-cell world
+// alignment despite float origin/resolution representation. Non-grid-aligned
+// callers retain the source truncation convention; this is not a grid resnap.
+int originPixelCorrection(const float current, const float next,
+                          const float resolution) {
+	const float shift = (current - next) / resolution;
+	const double value = static_cast<double>(shift);
+	if (!std::isfinite(value) ||
+	    value < static_cast<double>(std::numeric_limits<int>::min()) ||
+	    value > static_cast<double>(std::numeric_limits<int>::max())) {
+		throw std::invalid_argument("origin correction exceeds integer pixel range");
+	}
+	const double nearest = std::round(value);
+	// Bound float input/subtraction/division error in pixel units. At coarse
+	// world coordinates where uncertainty reaches a quarter cell, do not infer
+	// grid alignment from that uncertainty.
+	const double tolerance = std::numeric_limits<float>::epsilon() *
+		(std::abs(static_cast<double>(current)) + std::abs(static_cast<double>(next)) +
+		 std::abs(static_cast<double>(resolution)) * (std::abs(value) + 1.0)) /
+		std::abs(static_cast<double>(resolution));
+	if (tolerance < 0.25 && std::abs(value - nearest) <= tolerance) {
+		return static_cast<int>(std::lround(value));
+	}
+	return static_cast<int>(shift);
+}
 
